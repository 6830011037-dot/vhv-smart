{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vhv-smart",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://ctllgomqzeweeyrvxboc.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_P91Ii_-0k1YPlbsGqpFamA_Y8NBqhpr",
    "PATIENT_ACCESS_URL": "https://vhv-smart.nutjukka.workers.dev"
  },
  "secrets": {
    "required": [
      "SUPABASE_SECRET_KEY",
      "PATIENT_ACCESS_SESSION_SECRET"
    ]
  }
}
